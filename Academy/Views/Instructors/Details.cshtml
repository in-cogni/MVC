@model Academy.Models.Instructor
@using Academy.Models.ViewModels;

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Instructor</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.LastName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.LastName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FirstName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FirstName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.HireDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.HireDate)
        </dd>
    </dl>
    <div class="form-group">
        <label>Дисциплины:</label>
        <details class="border rounded p-2">
            <summary>Дисциплины</summary>
            <div class="mt-2" style="max-height: 100px; overflow-y: auto;">
                @foreach (AssignedCourseData course in ViewBag.Courses as List<AssignedCourseData>)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="selectedCourses"
                               value="@course.CourseID" id="course_@course.CourseID"
                        @(course.Assigned ? "checked" : "") />
                        <label class="form-check-label" for="course_@course.CourseID">
                            @course.CourseID - @course.Title
                        </label>
                    </div>
                }
            </div>
        </details>
    </div>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.ID">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>