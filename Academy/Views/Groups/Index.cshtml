@model PaginatedList<Academy.Models.Group>

@{
    ViewData["Title"] = "Index";
}

<h1>Группы</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["GroupNameSortParam"]" asp-route-currentFilter="@ViewData["CurrentFilter"]">Группа</a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["WeekDaysSortParam"]" asp-route-currentFilter="@ViewData["CurrentFilter"]">Дни недели</a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["StartTimeSortParam"]" asp-route-currentFilter="@ViewData["CurrentFilter"]">Время начала</a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["DirectionSortParam"]" asp-route-currentFilter="@ViewData["CurrentFilter"]">Направление</a>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.GroupName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.WeekDays)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.StartTime)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Direction.Name)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.GroupId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.GroupId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.GroupId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@{
    string prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
    string nextDisabled = !Model.HasNextPage ? "disabled" : "";
}

<a asp-action="Index"
   asp-route-sortOrder="@ViewData["CurrentSort"]"
   asp-route-pageNumber="@(Model.PageIndex - 1)"
   asp-route-currentFilter="@ViewData["CurrentFilter"]"
   class="btn btn-default @prevDisabled">
    Previous
</a>

<a asp-action="Index"
   asp-route-sortOrder="@ViewData["CurrentSort"]"
   asp-route-pageNumber="@(Model.PageIndex + 1)"
   asp-route-currentFilter="@ViewData["CurrentFilter"]"
   class="btn btn-default @nextDisabled">
    Next
</a>